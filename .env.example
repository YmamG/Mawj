# Copy to .env locally; never commit .env or paste credentials into chat.
# Providers: demo (simulation), manual, gemini, openai, claude
AI_PROVIDER=demo
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional model overrides: use a model available in your provider account.
GEMINI_MODEL=auto
# OPENAI_MODEL=your-model-name
# CLAUDE_MODEL=your-model-name
# Experimental branch only; leave disabled on the published instance.
# MAWJ_E2EE_JOURNAL_PREVIEW=1
