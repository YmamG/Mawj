# Reference only. On the HOST, copy required values into its private .env.
# Keep your local development .env separate. No real secrets belong in this file.
DJANGO_ALLOWED_HOSTS=yourusername.pythonanywhere.com
# Generate a new private key ON THE HOST; leaving this empty intentionally fails startup.
DJANGO_SECRET_KEY=
# Optional: defaults to https://<each allowed host> if omitted.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://yourusername.pythonanywhere.com
AI_PROVIDER=demo
# Live provider credentials, if later required, stay in the host's private .env.
